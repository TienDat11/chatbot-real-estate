{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rag-ragre.local/schemas/payment_methods.schema.json",
  "title": "payment_methods",
  "description": "Payment schedule + discount matrix for data/_processed/<project>/payment_methods.json. milestones are the payment ladder; method blocks are keyed by a short slug (tttd/ttdb/tts95/...).",
  "type": "object",
  "required": [
    "project",
    "source_dir",
    "extract_method",
    "note",
    "booking_and_deposit",
    "chuyen_khoan",
    "methods"
  ],
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "source_dir": {
      "type": "string"
    },
    "extract_method": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "booking_and_deposit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["deposit_vnd", "deposit_note"],
      "properties": {
        "deposit_vnd": { "type": "number" },
        "deposit_note": { "type": "string" }
      }
    },
    "chuyen_khoan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "chu_tai_khoan": { "type": "string" },
        "so_tai_khoan": { "type": "string" },
        "ngan_hang": { "type": "string" },
        "cu_phap": { "type": "string" }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["key", "name"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "only_block": { "type": "string" },
          "ck_phuong_thuc_pct": {
            "type": "object",
            "additionalProperties": {
              "type": ["number", "string"]
            }
          },
          "ck_khuyen_mai_pct": {
            "type": "object",
            "additionalProperties": true
          },
          "tong_ck_pct": {
            "type": "object",
            "additionalProperties": {
              "type": ["number", "string"]
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "order": { "type": "integer" },
                "milestone": { "type": "string" },
                "amount": { "type": "string" },
                "pct": { "type": ["number", "null"] },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
