# Environment template — copy to .env and fill in real values (never commit secrets).

# --- Postgres (LightRAG reads POSTGRES_* directly) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ragre
POSTGRES_PASSWORD=__CHANGE__
POSTGRES_DATABASE=ragre
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=64
LIGHTRAG_WORKSPACE=ragre_mvp
# RAG_PREWARM_ENABLED=true       # background LightRAG warm-up at startup (default ON; OFF keeps the lazy first-query init)
# PROMPT_DIR=            # LightRAG entity prompt dir (default: api/prompts — set only to override)

# --- Project image CDN / Cloudflare R2 ---
# JSON map; each project must declare origins and object-key namespaces. Never put secrets here.
# PRECEDENCE: when this map has an entry for a project it ALWAYS wins over
# R2_PUBLIC_URL; the global R2_PUBLIC_URL/r2_public_base applies only to
# deployments with NO map entry at all (single-project setups). One canonical
# origin per project: probe evidence lives in scripts/migrate_cdn_origins.py.
# Backend allowlist: project-specific origins and object-key namespaces.
IMAGE_CDN_PROJECT_MAP={"camellia":{"origins":["https://pub-__R2_ACCOUNT__.r2.dev"],"path_prefixes":["media/video/","images/matbang/","images/banggia/","images/camellia/"]},"soleil":{"origins":["https://pub-__R2_ACCOUNT__.r2.dev"],"path_prefixes":["images/soleil/","images/banggia/"]}}
# Frontend mirror allowlist: same public origin and the union of permitted namespaces.
# Leave unset in deployments without public media. Never add private/internal origins.
NEXT_PUBLIC_MEDIA_ORIGINS_JSON=[{"origin":"https://pub-__R2_ACCOUNT__.r2.dev","pathPrefixes":["media/video/","images/matbang/","images/banggia/","images/camellia/","images/soleil/"]}]
R2_ACCOUNT_ID=__CHANGE__
R2_ENDPOINT=https://__ACCOUNT__.r2.cloudflarestorage.com
R2_BUCKET_NAME=__CHANGE__
R2_ACCESS_KEY_ID=__CHANGE__
R2_SECRET_ACCESS_KEY=__CHANGE__
R2_PUBLIC_URL=https://__PUBLIC_HOST__

# --- Embedding ---
EMBEDDING_BINDING=gemini          # dashscope|aibox|local|openrouter|gemini
EMBEDDING_API_KEY=AQ.xxxxxxxxxxxx  # Google AI Studio (Gemini) key
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024
# OUTBOUND_ALLOWED_HOSTS=["openrouter.ai","generativelanguage.googleapis.com"]
# Revision-3 opt-in OpenRouter support (backward-compatible, safe opt-in)
# OPENROUTER_API_KEY=__CHANGE__
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_OPENROUTER_MODEL=openai/text-embedding-3-small
# OUTBOUND_ALLOW_PRIVATE=false

# --- Rerank ---
RERANK_BINDING=dashscope           # dashscope|aibox|openrouter|null — aibox uses RERANK_BASE_URL + /v1/rerank
RERANK_API_KEY=__CHANGE__
RERANK_BASE_URL=__CHANGE__
RERANK_MODEL=qwen3-rerank
# RERANK_OPENROUTER_MODEL=voyageai/rerank-2.5
ENABLE_RERANK=true

# --- Geo / Places (nearby amenities — default static fallback) ---
GEO_BINDING=static                 # static|google|off — google needs GEO_API_KEY + GEO_BASE_URL
# GEO_API_KEY=                    # Google Places API key (absent → static fallback)
# GEO_BASE_URL=https://maps.googleapis.com/maps/api/place
# GEO_RADIUS_M=10000              # search radius (meters)
# GEO_STATIC_PATH=db/seed/static_places.json
# GEO_CENTER_LAT=16.1052          # project center (THE CAMELLIA, giao lộ Lê Văn Lương - Lê Đức Thọ, Sơn Trà)
# GEO_CENTER_LNG=108.2558

# --- LLM gateway (OpenAI-compatible) ---
LLM_API_KEY=AQ.xxxxxxxxxxxx  # Google AI Studio (Gemini) key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# gemini-3.6-flash (stable); swap to gemini-2.5-flash if needed (env-driven).
LLM_MODEL_REWRITE=gemini-3.6-flash
LLM_MODEL_EXTRACT=gemini-3.6-flash
LLM_MODEL_ANSWER=gemini-3.6-flash
LLM_MODEL_ANSWER_PRO=gemini-3.6-flash
LLM_MODEL_GUARD=gemini-3.6-flash
LLM_MODEL_NL2SQL=gemini-3.6-flash
# Reasoning effort for the [OI]-compat route: none | low | medium | high ("none" clamps to "low" on Gemini 3.x).
LLM_REASONING_EFFORT=low

# --- LLM / RAG timeouts (seconds) ---
# Per-call budget for the slot-fill LLM completion (Google Gemini key via the
# OpenAI-compatible endpoint can be slow); conv_slots still fails open on timeout.
#LLM_SLOT_FILL_TIMEOUT_S=30.0
# Deadline for ONE rag_leg aquery_data call (hybrid retrieval fans out to
# embedding + PG graph queries); the retry-once behavior is unchanged.
#RAG_AQUERY_TIMEOUT_S=180.0

# --- Query budget (tokens) ---
QUERY_MAX_ENTITY_TOKENS=2000
QUERY_MAX_RELATION_TOKENS=2000
QUERY_MAX_TOTAL_TOKENS=6000

# --- Guard (L1) ---
# GUARD_INPUT_PG2_URL=     # optional Prompt Guard 2 /text/check endpoint (api/guard_input.py)
# SSE_TOTAL_TIMEOUT_S=150  # hard total deadline (s) for one SSE /query stream; heartbeats never reset it

# --- Ingest (defaults in api/config.py) ---
# CHUNK_CAP=1200           # hard cap per chunk
# EXTRACT_TIMEOUT=90.0     # seconds per extraction call
# MAX_ASYNC_LLM=6
# MAX_PARALLEL_WORKERS=2

# --- App ---
APP_ENV=dev
# CORS_ORIGINS=["http://localhost:3000"]   # JSON list — default localhost:3000

# --- Firebase (web app: apps/web — NEXT_PUBLIC_* are inlined into the browser bundle) ---
# The Web API key is the only value you must fill in. The rest default to values
# derived from project `sale-chat-bot-11e49` in apps/web/src/lib/firebase.ts and
# are overridable here if the project uses a custom domain/bucket.
# Get it at: Firebase Console → Project settings → General → Your apps → Web app → Config.
NEXT_PUBLIC_FIREBASE_API_KEY=__CHANGE__
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sale-chat-bot-11e49.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=sale-chat-bot-11e49
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sale-chat-bot-11e49.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1026596974795
# NEXT_PUBLIC_FIREBASE_APP_ID=1:1026596974795:web:2a0532da9d51507e046b4e
NEXT_PUBLIC_FIREBASE_VAPID_KEY=public-web-push-key

# --- Firebase backend binding (BE: REST + PyJWT+JWKS; firebase-admin BANNED per stack lock) ---
FIREBASE_BINDING=off               # off | firestore — firestore needs the service account vars below
FIREBASE_PROJECT_ID=sale-chat-bot-11e49
FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=   # JSON-escaped \n form from the service-account key file
# Ops-only web key: sales-user provisioning (scripts/provision_sales_user.py) and
# probe sign-in checks; never used for BE token verification (that is JWKS-only).
FIREBASE_WEB_API_KEY=

# Optional test/verification harness: Firebase uid of an ACTIVE, mapped sales row
# that receives EVERY new lead first (realtime manual verification). Blank
# preserves the LRU-first / priority-tiebreak fairness algorithm. Env-only.
# SALES_PREFERRED_FIREBASE_UID=

# --- Lead mirror (story 9.2: PG is source of truth; Firestore is a write-only mirror) ---
LEAD_MIRROR_RECONCILIATION_ENABLED=true   # background retry sweep for pending/failed mirror writes (firestore binding only)
LEAD_MIRROR_STALE_AFTER_MINUTES=300       # a pending/failed mirror row older than this is retried by the sweep
# LEAD_MIRROR_STALE_BATCH_LIMIT=50         # max mirror rows retried per sweep
# LEAD_MIRROR_SWEEP_INTERVAL_SECONDS=300   # sweep cadence (floored at 60s)
# LEAD_MIRROR_HMAC_SECRET=                # required in production; provide via secret manager, min 32 chars

# --- Signed anonymous identity (anti-spoof anon quota; secure wave) ---
# REQUIRED in production — startup fails fast without it. Generate a real value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# __GENERATE_ME__ below is a PLACEHOLDER, NOT a usable secret.
ANON_IDENTITY_SECRET=__GENERATE_ME__
ANONYMOUS_BONUS_TURNS_AFTER_LEAD=5         # one-time bonus turns granted after POST /api/lead
# IP_RATE_LIMIT_WINDOW_SECONDS=3600         # fixed-window size shared by all per-IP limits
# IP_RATE_LIMIT_MINT_MAX_REQUESTS=30        # anon identities minted per IP per window
# IP_RATE_LIMIT_QUERY_MAX_REQUESTS=120      # /query requests per IP per window
# IP_RATE_LIMIT_LEAD_MAX_REQUESTS=10        # /api/lead submissions per IP per window

# Supabase Postgres via Supavisor pooler (session mode :5432; transaction :6543).
# Placeholder only - never commit real credentials.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
SUPABASE_STAGING_HOST_ALLOWLIST=db.<project-ref>.supabase.co,aws-<n>-<region>.pooler.supabase.com
