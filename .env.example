# Environment template — copy to .env and fill in real values (never commit secrets).

# --- Postgres (LightRAG reads POSTGRES_* directly) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ragre
POSTGRES_PASSWORD=__CHANGE__
POSTGRES_DATABASE=ragre
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=64
LIGHTRAG_WORKSPACE=ragre_mvp
# PROMPT_DIR=            # LightRAG entity prompt dir (default: api/prompts — set only to override)

# --- Embedding ---
EMBEDDING_BINDING=dashscope        # dashscope|aibox|local
EMBEDDING_API_KEY=__CHANGE__
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# --- Rerank ---
RERANK_BINDING=dashscope           # dashscope|aibox|null — aibox uses RERANK_BASE_URL + /v1/rerank
RERANK_API_KEY=__CHANGE__
RERANK_BASE_URL=__CHANGE__
RERANK_MODEL=qwen3-rerank
ENABLE_RERANK=true

# --- Geo / Places (nearby amenities — default static fallback) ---
GEO_BINDING=static                 # static|google|off — google needs GEO_API_KEY + GEO_BASE_URL
# GEO_API_KEY=                    # Google Places API key (absent → static fallback)
# GEO_BASE_URL=https://maps.googleapis.com/maps/api/place
# GEO_RADIUS_M=10000              # search radius (meters)
# GEO_STATIC_PATH=db/seed/static_places.json
# GEO_CENTER_LAT=16.1052          # project center (THE CAMELLIA, giao lộ Lê Văn Lương - Lê Đức Thọ, Sơn Trà)
# GEO_CENTER_LNG=108.2558

# --- LLM gateway (OpenAI-compatible) ---
LLM_API_KEY=__CHANGE__
LLM_BASE_URL=__CHANGE__
LLM_MODEL_REWRITE=deepseek-v4-flash
LLM_MODEL_EXTRACT=qwen3.7-flash
LLM_MODEL_ANSWER=deepseek-v4-flash
LLM_MODEL_ANSWER_PRO=deepseek-v4-pro
LLM_MODEL_GUARD=deepseek-v4-flash-0731
LLM_MODEL_NL2SQL=qwen3.7-flash

# --- Query budget (tokens) ---
QUERY_MAX_ENTITY_TOKENS=2000
QUERY_MAX_RELATION_TOKENS=2000
QUERY_MAX_TOTAL_TOKENS=6000

# --- Guard (L1) ---
# GUARD_INPUT_PG2_URL=     # optional Prompt Guard 2 /text/check endpoint (api/guard_input.py)

# --- Ingest (defaults in api/config.py) ---
# CHUNK_CAP=1200           # hard cap per chunk
# EXTRACT_TIMEOUT=90.0     # seconds per extraction call
# MAX_ASYNC_LLM=6
# MAX_PARALLEL_WORKERS=2

# --- App ---
APP_ENV=dev
# CORS_ORIGINS=["http://localhost:3000"]   # JSON list — default localhost:3000

# --- Firebase (web app: apps/web — NEXT_PUBLIC_* are inlined into the browser bundle) ---
# The Web API key is the only value you must fill in. The rest default to values
# derived from project `sale-chat-bot-11e49` in apps/web/src/lib/firebase.ts and
# are overridable here if the project uses a custom domain/bucket.
# Get it at: Firebase Console → Project settings → General → Your apps → Web app → Config.
NEXT_PUBLIC_FIREBASE_API_KEY=__CHANGE__
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sale-chat-bot-11e49.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=sale-chat-bot-11e49
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sale-chat-bot-11e49.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1026596974795
# NEXT_PUBLIC_FIREBASE_APP_ID=1:1026596974795:web:2a0532da9d51507e046b4e

# --- Firebase backend binding (BE: REST + PyJWT+JWKS; firebase-admin BANNED per stack lock) ---
FIREBASE_BINDING=off               # off | firestore — firestore needs the service account vars below
FIREBASE_PROJECT_ID=sale-chat-bot-11e49
FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=   # JSON-escaped \n form from the service-account key file
